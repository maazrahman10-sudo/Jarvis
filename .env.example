# Copy to .env. Never share this file after adding a real key.
GEMINI_API_KEY=
# Set an available model from your Google AI Studio account. No model is assumed.
GEMINI_MODEL=
# Optional: absolute folder for local SQLite data (default: ~/.jarvis)
# JARVIS_DATA_DIR=C:\Users\YourName\.jarvis

# Optional Fish Audio speech. Replace any key shared in chat before use.
FISH_API_KEY=
# Optional authorized voice reference ID, and optional model header for your account.
FISH_REFERENCE_ID=
FISH_MODEL=
